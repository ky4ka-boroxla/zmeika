{
    "manifest_version": 3,
    "name": "Змейка",
    "version": "1.0.0",
    "description": "Классическая змейка с комбо, золотой едой, скинами и достижениями",
    "action": {
        "default_title": "Играть в Змейку",
        "default_icon": {
            "16": "icon-32.png",
            "32": "icon-32.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icon-32.png",
        "32": "icon-32.png",
        "48": "icon-192.png",
        "128": "icon-512.png"
    }
}
